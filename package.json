{
  "name": "hsr-warp",
  "version": "0.1.0",
  "description": "자가 호스팅 HSR 워프 추적기 — 단일 Go 실행파일 + 로컬 대시보드",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "node scripts/run-go.mjs build -ldflags=\"-s -w\" -o hsr-warp.exe .",
    "build:debug": "node scripts/run-go.mjs build -ldflags=\"-s -w -X main.logLevel=debug\" -o hsr-warp-debug.exe .",
    "start": "npm run build && hsr-warp.exe",
    "start:debug": "npm run build:debug && hsr-warp-debug.exe",
    "vet": "node scripts/run-go.mjs vet ./...",
    "test": "node scripts/run-go.mjs test ./... && node web/analyze.test.js && node docs/site/guide.test.js && node scripts/build-pages.test.mjs",
    "test:go": "node scripts/run-go.mjs test ./...",
    "test:analyze": "node web/analyze.test.js"
  }
}
